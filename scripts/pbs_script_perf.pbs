#!/bin/bash
# Job name
#PBS -N perf_benchmark

# Output and error file
#PBS -o results/perf_benchmark.out
#PBS -e results/perf_benchmark.err

# Queue name
#PBS -q short_cpuQ

# Set the max wall time
#PBS -l walltime=04:00:00

# Set the other things
#PBS -l select=1:ncpus=64:mem=32gb

module load gcc91 || { echo "module load failed"; exit 1; }
module load perf || { echo "module load failed"; exit 1; }

cd "$PBS_O_WORKDIR" || { echo "PBS_O_WORKDIR not set or inaccessible"; exit 1; } # go to the dir where the qsub was run

EXECUTABLE="./spmv"
MATRICES=(
    "af23560.mtx"
    "twotone.mtx"
    "tmt_unsym.mtx"
    "atmosmodl.mtx"
    "Freescale1.mtx"
)
DATA_DIR="data"
MODES=(
    "static"
    "dynamic"
    "guided"
)
CHUNK_SIZE=(1 10 100 1000)
THREADS=(1 2 4 8 16 32 64)
NUM_RUNS=1
RESULTS_DIR="results"
PERF_CSV="$RESULTS_DIR/perf_results.csv"
PERF_RUNS=5

# Events to measure
PERF_EVENTS="cache-misses,cache-references,LLC-load-misses,instructions,cycles"

gcc-9.1.0 -Wall -O3 -fopenmp src/main.c src/matrix.c src/mmio.c -o spmv -lm

# Setup
mkdir -p $RESULTS_DIR
rm -f $PERF_CSV

echo "Matrix,Mode,ChunkSize,Threads,Cycles,Instructions,CacheMisses,CacheRefs,LLCMisses" > $PERF_CSV

perf_avg() {
    local PERF_OUTPUT
    PERF_OUTPUT=$(perf stat -r $PERF_RUNS -e $PERF_EVENTS -- "$@" 2>&1 >/dev/null)   # -r = repeat

    if [ $? -ne 0 ]; then
        echo "perf stat failed (or program crashed) for command: $*" >&2
        # Return "ERROR" for all fields
        echo "ERROR,ERROR,ERROR,ERROR,ERROR"
        return
    fi

    local CYCLES=$(echo "$PERF_OUTPUT" | grep "cycles" | awk '{print $1}' | sed 's/,//g')
    local INSTRUCTIONS=$(echo "$PERF_OUTPUT" | grep "instructions" | awk '{print $1}' | sed 's/,//g')
    local CACHE_MISSES=$(echo "$PERF_OUTPUT" | grep "cache-misses" | awk '{print $1}' | sed 's/,//g')
    local CACHE_REFS=$(echo "$PERF_OUTPUT" | grep "cache-references" | awk '{print $1}' | sed 's/,//g')
    local LLC_MISSES=$(echo "$PERF_OUTPUT" | grep "LLC-load-misses" | awk '{print $1}' | sed 's/,//g')

    CYCLES=${CYCLES:-0}
    INSTRUCTIONS=${INSTRUCTIONS:-0}
    CACHE_MISSES=${CACHE_MISSES:-0}
    CACHE_REFS=${CACHE_REFS:-0}
    LLC_MISSES=${LLC_MISSES:-0}

    echo "$CYCLES,$INSTRUCTIONS,$CACHE_MISSES,$CACHE_REFS,$LLC_MISSES"
}

for MATRIX_NAME in "${MATRICES[@]}"
do
    MATRIX_FILE="$DATA_DIR/$MATRIX_NAME"

    # Sequential version 
    echo "Running PERF (avg over $PERF_RUNS runs): $MATRIX_NAME, seq, NA, 1 thread"

    PERF_STATS=$(perf_avg $EXECUTABLE $MATRIX_FILE seq 1 1 $NUM_RUNS)
    echo "$MATRIX_NAME,seq,NA,1,$PERF_STATS" >> $PERF_CSV

    # Parallel versions
    for MODE in "${MODES[@]}"
    do
        for CHUNK in "${CHUNK_SIZE[@]}"
        do
            for T in "${THREADS[@]}"
            do 
                echo "Running PERF (avg over $PERF_RUNS runs): $MATRIX_NAME, $MODE, $CHUNK, $T threads"
                
                PERF_STATS=$(perf_avg $EXECUTABLE $MATRIX_FILE $MODE $CHUNK $T $NUM_RUNS)
                echo "$MATRIX_NAME,$MODE,$CHUNK,$T,$PERF_STATS" >> $PERF_CSV
            done
        done
    done
done

echo "Performance data (averaged over $PERF_RUNS runs) saved in $PERF_CSV"